---
import "../styles/global.css";
---

<!doctype html>
<html lang="de" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Impressum | all-the.rest</title>
    <meta name="description" content="Impressum von all-the.rest." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌐</text></svg>" />
    <script src="https://stats.all-the.rest/x7k2p.js" defer></script>
  </head>
  <body class="h-full font-sans antialiased">
    <main class="mx-auto flex min-h-full max-w-2xl flex-col justify-center px-4 py-16">
      <a href="/" class="mb-8 text-sm text-base-content/50 hover:text-primary transition-colors no-underline">
        &larr; Zurück
      </a>

      <h1 class="mb-8 text-4xl font-bold tracking-tight">Impressum</h1>

      <p class="text-base-content/60 mb-2">Angaben gemäß &sect; 5 ECG</p>

      <div class="card bg-base-200">
        <div class="card-body p-6">
          <p class="font-medium">Florian Reisinger</p>
          <p>Robert-Stolz-Straße 8</p>
          <p>4020 Linz</p>
          <p>Österreich</p>
          <p class="mt-4">Kontakt:</p>
          <p>
            E-Mail:
            <a href="mailto:hello@all-the.rest" class="link link-primary">hello@all-the.rest</a>
          </p>
        </div>
      </div>

      <p class="mt-8 text-xs text-base-content/40">
        Dies ist ein privates, nicht-kommerzielles Projekt. Verantwortlich für den Inhalt:
        Florian Reisinger.
      </p>

      <p class="mt-16 text-xs text-base-content/30">
        &copy; {new Date().getFullYear()} Florian Reisinger
      </p>
    </main>
  </body>
</html>
